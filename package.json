{
  "name": "campus-job-desk-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": ".venv/bin/uvicorn campus_job_desk.api.app:app --reload --app-dir src --host 127.0.0.1 --port 8000",
    "dev:web": "vite --host 127.0.0.1 --port 5173",
    "build": "tsc -b && vite build",
    "build:pages": "tsc -b && VITE_STATIC_DEMO=true vite build --outDir=../dist-pages",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "preview:pages": "VITE_STATIC_DEMO=true vite preview --outDir=../dist-pages --host 127.0.0.1 --port 4174",
    "test:web": "vitest run",
    "test": "npm run test:web && .venv/bin/pytest",
    "lint:web": "eslint web/src vite.config.ts",
    "lint": "npm run lint:web && .venv/bin/ruff check src tests scripts",
    "format:check": "prettier --check web/src vite.config.ts package.json",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.8.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "eslint": "^9.33.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.2",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.39.1",
    "vite": "^7.1.2",
    "vitest": "^3.2.4"
  }
}

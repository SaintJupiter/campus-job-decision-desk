        "result": "OPEN",
        "candidate": "https://jobs.synthetic-example.com/campus/2027",
        "evidence_excerpt": "页面显示校园招聘正在接受申请",
        "extracted_fields": {},
        "expected_error": "核验页未结构化匹配当前岗位的官方 ID"
      },

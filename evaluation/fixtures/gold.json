        "official_job_id": "PM-1001",
        "expected": true
      },
      {
        "id": "contract.verification.article_id_is_not_job_identity",
        "operation": "official_job_id_match",
        "candidate": "https://jobs.synthetic-example.com/news/PM-1001",
        "official_job_id": "PM-1001",
        "expected": false
      },
      {
        "id": "contract.verification.graduation_year_is_not_job_identity",
        "operation": "official_job_id_match",
        "candidate": "https://jobs.synthetic-example.com/jobs/2027",
        "official_job_id": "2027",
        "expected": false
      },
      {
        "id": "contract.verification.campaign_token_is_not_job_identity",
        "operation": "official_job_id_match",
        "candidate": "https://jobs.synthetic-example.com/jobs/campus-2027",
        "official_job_id": "campus-2027",
        "expected": false
      },
      {
        "id": "contract.verification.unresolved_page_cannot_write_claims",
        "operation": "record_verification",
        "result": "NOT_FOUND",
        "candidate": "https://jobs.synthetic-example.com/jobs/PM-1001",

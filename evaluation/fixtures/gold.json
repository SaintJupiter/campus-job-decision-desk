        "id": "contract.verification.shared_ats_rejects_other_tenant",
        "operation": "record_verification",
        "result": "OPEN",
        "candidate": "https://job-boards.greenhouse.io/company-b/jobs/PM-1001",
        "official_domain": "job-boards.greenhouse.io",
        "official_scope_path": "/company-a",
        "evidence_excerpt": "页面显示岗位正在接受申请",
        "extracted_fields": {},
        "expected_error": "核验链接与岗位官网域名或公司租户路径不匹配"
      }

    },
    {
      "id": "contract.verification.reject_workday_infrastructure_domain",
      "operation": "normalize_scope",
      "candidate": "wd5.myworkdayjobs.com",
      "expected_error": "共享 ATS 父域不能作为单家公司官网；请提供包含公司租户的招聘页面 URL"
    },
      {
        "id": "contract.verification.shared_ats_keeps_tenant_scope",
        "operation": "normalize_scope",
        "candidate": "https://job-boards.greenhouse.io/company-a/jobs",
        "expected": {
          "domain": "job-boards.greenhouse.io",
          "scope_path": "/company-a"
        }
      },
      {
        "id": "contract.verification.job_id_matches_direct_path",

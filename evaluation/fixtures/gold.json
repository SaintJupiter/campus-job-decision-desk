        "candidate": "127.0.0.1",
        "expected_error": "IP 地址不能作为官方招聘域名"
      },
    {
      "id": "contract.verification.shared_ats_requires_tenant",
        "operation": "normalize_scope",
        "candidate": "job-boards.greenhouse.io",

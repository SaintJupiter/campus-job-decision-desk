# Local writable workspace. Never commit a private database.
CJD_ENVIRONMENT=development
CJD_DATABASE_URL=sqlite:///data/private/campus-job-desk-app.sqlite

# Feishu Bitable authentication. Choose one mode; credentials stay in env only.
# CJD_FEISHU_ACCESS_TOKEN=
# CJD_FEISHU_APP_ID=cli_xxx
# CJD_FEISHU_APP_SECRET=

CJD_REMOTE_SYNC_TIMEOUT_SECONDS=30
